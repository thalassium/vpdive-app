# Copy to .env.local (never committed).

# Used only by scripts/probe.ts (npm run probe): a VPDive admin account.
VPDIVE_EMAIL=
VPDIVE_PASSWORD=
# Optional overrides
# VPDIVE_API_BASE=https://septentrion-env.vpdive.com/api
# Calendar token used by the probe when /calendar/list gives none (never commit its value).
# VPDIVE_CALENDAR_TOKEN=

# App super-admins (comma-separated VPDive login e-mails). On Vercel, set it
# in Project Settings → Environment Variables. They cannot be demoted in the app.
SUPER_ADMIN_EMAILS=

# Shared store. On Vercel, Storage → Create Database → Upstash (Redis), connected to
# the project, sets these (possibly with a prefix: the server accepts any).
# Locally, leave empty: data goes to .data/app-store.json.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# HelloAsso (gestion des adhésions) : clé API de l'association.
# HELLOASSO_CLIENT_ID=
# HELLOASSO_CLIENT_SECRET=
# HELLOASSO_ORG_SLUG=

# Sauvegarde quotidienne (Vercel Cron → /api/backup → Supabase Storage).
# CRON_SECRET : chaîne aléatoire d'au moins 16 caractères ; Vercel l'envoie dans
# l'en-tête Authorization des appels du cron.
# CRON_SECRET=
# SUPABASE_URL=https://<projet>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BACKUP_BUCKET=gabian-backups
